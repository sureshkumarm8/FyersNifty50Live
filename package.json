  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "./start-dev.sh",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server.js",
    "generate:paytm": "node scripts/generatePaytmMappings.cjs",
    "model:train": "node ml/export.mjs",
