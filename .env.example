# ==============================================
# Environment Variables for Vercel Deployment
# ==============================================
# Copy values from your Nifty50_AI_config_tokens.json file

# Required: PayTM Money API Token
PAYTM_ACCESS_TOKEN=your_paytm_access_token_here

# Required: Upstash Redis (for data persistence)
# NOTE: If using Vercel's Upstash integration, these are auto-created as KV_*
# The code will automatically use KV_REST_API_URL and KV_REST_API_TOKEN if UPSTASH_* not found
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# Optional: Cron job security (recommended)
# Generate with: openssl rand -base64 32
CRON_SECRET=your_random_secret_key_here

# Optional: Bypass market hours check (for testing)
BYPASS_MARKET_HOURS=false

# ==============================================
# DEPLOYMENT INSTRUCTIONS
# ==============================================
#
# For Vercel:
#   1. Go to: https://vercel.com/dashboard
#   2. Your Project → Settings → Environment Variables
#   3. Add PAYTM_ACCESS_TOKEN (required)
#   4. Add Upstash Redis integration (required - creates KV_* variables automatically)
#      OR manually add UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN
#   5. Add CRON_SECRET (optional but recommended)
#
# For Upstash Redis (if not using Vercel integration):
#   1. Sign up at: https://upstash.com/ (Free tier available)
#   2. Create new Redis database
#   3. Copy REST URL and REST TOKEN
#   4. Add to Vercel environment variables
#
# For cron-job.org:
#   1. Sign up at: https://cron-job.org/en/signup/
#   2. Create cron job: https://your-app.vercel.app/api/cron-fetch
#   3. Schedule: Every 1 minute, Mon-Fri, 03:47-09:45 UTC
#   4. (Optional) Add header: Authorization: Bearer {CRON_SECRET}
#
# Full guide: See EXTERNAL_CRON_SETUP.md
# ==============================================

# ==============================================
# Nifty50Ops agent (local server only — see NIFTY50OPS_AGENT_PLAN.md)
# ==============================================
# Model for the ops chat, the 09:05 readiness note and the debrief narrative.
# gemini (default when a key is set) or ollama (local, no key), or a CLI that is
# already signed in on this Mac: claude-code (alias claude), copilot,
# antigravity (alias agy). CLIs run with their own tools switched off.
OPS_AI_PROVIDER=gemini
# Leave empty for a CLI's own default (e.g. haiku/sonnet for claude-code,
# claude-sonnet-4.5/gpt-5 for copilot).
OPS_AI_MODEL=gemini-2.5-flash
# CLI paths, if not on PATH / ~/.local/bin / /opt/homebrew/bin:
# OPS_CLAUDE_BIN=  OPS_COPILOT_BIN=  OPS_AGY_BIN=
# GEMINI_API_KEY or GOOGLE_API_KEY. A key in .env.local wins over one in the shell.
GEMINI_API_KEY=your_gemini_key_here
# OPS_OLLAMA_URL=http://127.0.0.1:11434

# Autonomy: L0 = read-only (chat default), L1 = + pre-flight, chart pull,
# notifications, debrief (daemon default). Anything higher is clamped to L1.
OPS_AUTONOMY_LEVEL=L0
# OPS_DAEMON_AUTONOMY_LEVEL=L1
# OPS_DAEMON_START_SERVER=true      # daemon starts server.js at 08:35 if it is down

# Where the day journal lives (default ~/TradingJournal, falling back to ./TradingJournal)
# OPS_JOURNAL_ROOT=/Users/you/TradingJournal

# Bind the server to this machine only (default: all interfaces). The kill
# switch, order placement, journal and ops routes are loopback-only regardless.
# BIND_HOST=127.0.0.1

# Optional Telegram notifications (macOS notifications are always on)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
