# ==============================================
# Environment Variables for Vercel Deployment
# ==============================================
# Copy values from your Nifty50_AI_config_tokens.json file

# Required: PayTM Money API Token
PAYTM_ACCESS_TOKEN=your_paytm_access_token_here

# Optional: Cron job security (recommended)
# Generate with: openssl rand -base64 32
CRON_SECRET=your_random_secret_key_here

# Optional: Bypass market hours check (for testing)
BYPASS_MARKET_HOURS=false

# ==============================================
# DEPLOYMENT INSTRUCTIONS
# ==============================================
#
# For Vercel:
#   1. Go to: https://vercel.com/dashboard
#   2. Your Project → Settings → Environment Variables
#   3. Add PAYTM_ACCESS_TOKEN (required)
#   4. Add CRON_SECRET (optional but recommended)
#
# For cron-job.org:
#   1. Sign up at: https://cron-job.org/en/signup/
#   2. Create cron job: https://your-app.vercel.app/api/cron-fetch
#   3. Schedule: Every 1 minute, Mon-Fri, 03:47-09:45 UTC
#   4. (Optional) Add header: Authorization: Bearer {CRON_SECRET}
#
# Full guide: See EXTERNAL_CRON_SETUP.md
# ==============================================
