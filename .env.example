# ==============================================
# Nifty 50 Live Market Dashboard - Environment Variables
# ==============================================
# Copy this file to .env and fill in your actual values
# For Vercel deployment, add these in: Dashboard → Settings → Environment Variables

# ==============================================
# PAYTM MONEY API CREDENTIALS
# ==============================================
# Get from: https://developer.paytmmoney.com/
PAYTM_API_KEY=your_paytm_api_key_here
PAYTM_API_SECRET=your_paytm_api_secret_here
PAYTM_ACCESS_TOKEN=your_paytm_access_token_here

# ==============================================
# FYERS API CREDENTIALS (Optional)
# ==============================================
# Get from: https://myapi.fyers.in/
FYERS_CLIENT_ID=your_fyers_client_id_here
FYERS_SECRET_KEY=your_fyers_secret_key_here
FYERS_ACCESS_TOKEN=your_fyers_access_token_here

# ==============================================
# AI/ML API KEYS
# ==============================================

# Google Gemini API Key (for AI analysis)
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Groq API Key (alternative AI provider)
# Get from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Claude API Key (optional - for advanced analysis)
# Get from: https://console.anthropic.com/
CLAUDE_API_KEY=your_claude_api_key_here

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================

# Bypass market hours check (for testing)
# Set to 'true' to fetch data even outside market hours
BYPASS_MARKET_HOURS=false

# Data refresh interval in milliseconds (default: 60000 = 1 minute)
REFRESH_INTERVAL=60000

# ==============================================
# SECURITY
# ==============================================

# Cron job secret for Vercel cron authentication
# Generate a random string: openssl rand -base64 32
CRON_SECRET=your_random_secret_here

# ==============================================
# DEPLOYMENT NOTES
# ==============================================
# 
# For Vercel Deployment:
# 1. Go to: https://vercel.com/dashboard
# 2. Select your project
# 3. Go to Settings → Environment Variables
# 4. Add each variable above (one by one)
# 5. Set environment: Production (or All)
# 6. Click "Save"
#
# For Local Development:
# 1. Copy this file to .env
# 2. Fill in your actual API keys
# 3. The .env file is gitignored (never commit it!)
#
# ==============================================
