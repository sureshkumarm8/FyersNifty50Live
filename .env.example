# Nifty50 Live Dashboard - Environment Variables Template
# Copy this to .env.local for local development
# Set these in Vercel Dashboard → Settings → Environment Variables for production

# IMPORTANT: Never commit .env.local or expose real API keys in Git!

# PayTM API Credentials
VITE_PAYTM_API_KEY=
VITE_PAYTM_API_SECRET=
VITE_PAYTM_ACCESS_TOKEN=

# Fyers API Credentials
VITE_FYERS_CLIENT_ID=
VITE_FYERS_SECRET_KEY=
VITE_FYERS_ACCESS_TOKEN=

# Google Gemini API
VITE_GOOGLE_API_KEY=

# Groq API
VITE_GROQ_API_KEY=

# Claude API
VITE_CLAUDE_API_KEY=

# App Configuration
VITE_BYPASS_MARKET_HOURS=false
VITE_REFRESH_INTERVAL=60000
